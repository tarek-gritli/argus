REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus

# GitHub App
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_B64=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth
JWT_SECRET_KEY=
JWT_TTL_SECONDS=86400

# Encryption at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_ENCRYPTION_KEY=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Linear OAuth
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Jira OAuth
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# App base URL (used to build OAuth redirect URIs)
APP_BASE_URL=http://localhost:8000

# Environment
ENV=development

API_PREFIX=/api/v1

# LLM
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_EMBEDDING_DIM=1024

# Voyage AI (embeddings)
VOYAGE_API_KEY=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# Observability (Langfuse — optional, tracing disabled when unset)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Dashboard (optional — internal token for dashboard auth)
DASHBOARD_TOKEN_SECRET=