REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Github
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_B64=

# Gitlab
GITLAB_ACCESS_TOKEN= < your gitlab personal access token > # OBTAINED FROM GITLAB USER SETTINGS
GITLAB_WEBHOOK_SECRET= < your gitlab webhook secret > # OBTAINED FROM GITLAB WEBHOOK SETTINGS
GITLAB_BOT_USER_ID= < your gitlab bot user id > # CAN BE SKIPPED IF NOT USING A BOT USER
GITLAB_SIGNING_TOKEN= < your gitlab signing token > # OBTAINED FROM GITLAB WEBHOOK SETTINGS

# Environment
ENV=development

API_PREFIX=/api/v1

# LLM
ANTHROPIC_API_KEY=
